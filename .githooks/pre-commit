#!/bin/sh
# Refuse staged lines that add an em dash (U+2014) or an en dash (U+2013).
# The rule is repo-wide, see .github/copilot-instructions.md and README.md.
# Both characters are built at runtime from their UTF-8 bytes, so this file
# stays free of them and never trips over itself.
#
# Enable once per clone:  git config core.hooksPath .githooks

em=$(printf '\342\200\224')
en=$(printf '\342\200\223')

bad=$(git diff --cached --no-color --diff-filter=ACM -U0 \
    | awk '/^\+\+\+ /{f=substr($0, 7)} /^\+/ && !/^\+\+\+ /{print f ": " $0}' \
    | grep -F -e "$em" -e "$en")

if [ -n "$bad" ]; then
    echo "pre-commit: em dash or en dash in staged lines:" >&2
    printf '%s\n' "$bad" | cut -c 1-160 | head -20 >&2
    echo "Use a colon, comma, parentheses, semicolon or a separate sentence." >&2
    echo "Plain hyphens in compound words and ranges (2-4 Wochen) are fine." >&2
    exit 1
fi

exit 0
